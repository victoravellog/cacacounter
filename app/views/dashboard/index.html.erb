<% content_for :title, "El Pañalómetro de Violeta 💜" %>

<% if total_diapers_changed > 0 %>
  <div class="stats-banner">
    <div class="stat-card">
      <div class="number"><%= total_diapers_changed %></div>
      <div class="label">Pañales cambiados</div>
      <% if diaper_milestone_message %>
        <div class="milestone"><%= diaper_milestone_message %></div>
      <% end %>
    </div>
    <% if violeta_days_old && violeta_days_old > 0 %>
      <div class="stat-card">
        <div class="number"><%= (total_diapers_changed.to_f / violeta_days_old).round(1) %></div>
        <div class="label">Promedio diario</div>
      </div>
    <% end %>
  </div>

  <div class="encouragement">
    <%= random_encouragement %>
  </div>
<% end %>

<h2>Registrar cambio</h2>
<div class="quick-log">
  <% @sizes.each do |size| %>
    <%= button_to diaper_changes_path(diaper_change: { size: size }), method: :post, class: "btn btn-primary" do %>
      <span class="size"><%= size %></span>
      <span>+1</span>
    <% end %>
  <% end %>
</div>
<p><%= link_to "Registrar con hora/notas personalizadas →", new_diaper_change_path, class: "btn btn-sm" %></p>

<h2>Stock disponible</h2>
<%= render "stock_grid", summaries: @summaries %>

<p><%= link_to "+ Registrar compra de pañales", new_diaper_purchase_path, class: "btn btn-cyan" %></p>

<h2>Actividad reciente</h2>
<%= render "recent_activity", recent_changes: @recent_changes %>
