<% content_for :title, "Cacacounter 💩" %>

<h2>Registrar cambio</h2>
<div class="quick-log">
  <% @sizes.each do |size| %>
    <%= button_to diaper_changes_path(diaper_change: { size: size }), method: :post, class: "btn btn-primary" do %>
      <span class="size"><%= size %></span>
      <span>+1</span>
    <% end %>
  <% end %>
</div>
<p><%= link_to "Registrar con hora/notas personalizadas →", new_diaper_change_path, class: "btn btn-sm" %></p>

<h2>Stock disponible</h2>
<% if @summaries.any? %>
  <div class="stock-grid">
    <% @summaries.each do |summary| %>
      <div class="stock-card <%= "low" if summary.low_stock? %>">
        <div class="size">Talla <%= summary.size %></div>
        <div class="count"><%= summary.stock %></div>
        <div class="meta">
          <% if summary.avg_daily_usage.positive? %>
            ~<%= summary.avg_daily_usage.round(1) %>/día
            <% if summary.estimated_days_left %>
              · quedan ~<%= summary.estimated_days_left %> días
            <% end %>
          <% else %>
            sin uso reciente
          <% end %>
        </div>
        <% if summary.low_stock? %>
          <div class="warning">¡Comprar pronto!</div>
        <% end %>
      </div>
    <% end %>
  </div>
<% else %>
  <div class="empty-state">
    Aún no hay datos. Registra una compra y un cambio de pañal para empezar a ver el stock.
  </div>
<% end %>

<p><%= link_to "+ Registrar compra de pañales", new_diaper_purchase_path, class: "btn btn-cyan" %></p>

<h2>Actividad reciente</h2>
<% if @recent_changes.any? %>
  <ul class="entry-list">
    <% @recent_changes.each do |change| %>
      <li>
        <div>
          <span class="tag"><%= change.size %></span>
          <span class="when"><%= change.occurred_at.strftime("%d/%m %H:%M") %></span>
          <% if change.notes.present? %>
            <div class="notes"><%= change.notes %></div>
          <% end %>
        </div>
        <%= button_to "Borrar", diaper_change_path(change), method: :delete, class: "btn btn-sm btn-danger", form: { data: { turbo_confirm: "¿Eliminar este registro?" } } %>
      </li>
    <% end %>
  </ul>
<% else %>
  <div class="empty-state">Sin registros todavía.</div>
<% end %>
