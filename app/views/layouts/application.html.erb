<!DOCTYPE html>
<html>
  <head>
    <title><%= content_for(:title) || "El Pañalómetro de Violeta 💜" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="application-name" content="Pañalómetro de Violeta">
    <meta name="mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">

    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <script>
      // Apply theme before paint to avoid flash
      (function() {
        if (localStorage.getItem("theme") === "night") {
          document.documentElement.classList.add("night-mode-preload");
        }
      })();
    </script>
    <%= javascript_importmap_tags %>
  </head>

  <body data-controller="theme">
    <header class="site-header">
      <div>
        <h1>
          <a href="<%= root_path %>">
            <span class="violet-flower">🌸</span>
            El Pañalómetro de Violeta
          </a>
        </h1>
        <div class="subtitle"><%= violeta_status %></div>
      </div>
      <nav>
        <%= link_to "Historial", diaper_changes_path, class: "btn btn-sm" %>
        <%= link_to "Compras", diaper_purchases_path, class: "btn btn-sm" %>
        <button class="theme-toggle" data-action="click->theme#toggle" title="Cambiar modo">
          <span data-theme-target="icon">🌙</span>
        </button>
      </nav>
    </header>

    <div class="wrap">
      <% flash.each do |type, message| %>
        <div class="flash"><%= message %></div>
      <% end %>

      <%= yield %>
    </div>
  </body>
</html>
